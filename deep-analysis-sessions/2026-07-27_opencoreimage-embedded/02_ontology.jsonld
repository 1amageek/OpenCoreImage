  "@graph": [
    {
      "@id": "ea:session/2026-07-27_opencoreimage-embedded/topic/T001",
      "@type": "Topic",
      "title": "Swift 6.4 target baseline",
      "content": "Native compatibility, browser WASM, and Embedded WASM must use the fixed 2026-07-17 Swift 6.4 development snapshot and matching SDKs.",
      "epistemicStatus": "Verified",
      "confidence": 0.98,
      "decompositionStrategy": "target comparison"
    },
    {
      "@id": "ea:session/2026-07-27_opencoreimage-embedded/question/Q001",
      "@type": "Question",
      "title": "First Embedded build failure",
      "content": "Which OpenCoreImage or dependency declaration first prevents Embedded WASM compile or link?",
      "epistemicStatus": "Verified",
      "confidence": 0.98,
      "questionStatus": "Resolved",
      "asksAbout": [
        "ea:session/2026-07-27_opencoreimage-embedded/topic/T002"
      ],
      "resolvedBy": [
        "ea:session/2026-07-27_opencoreimage-embedded/evidence/E001"
      ]
    },
    {
      "@id": "ea:session/2026-07-27_opencoreimage-embedded/topic/T002",
      "@type": "Topic",
      "title": "Renderer capability selection",
      "content": "CIContext must select a renderer by actual target capability while preserving one ownership and typed-failure contract across targets.",
      "epistemicStatus": "Hypothesized",
      "confidence": 0.6,
      "decompositionStrategy": "causal and structural",
      "investigations": []
    },
    {
      "@id": "ea:session/2026-07-27_opencoreimage-embedded/evidence/E001",
      "@type": "Evidence",
      "title": "Embedded build first fails in SwiftWebGPU promise access",
      "content": "The fixed Swift 6.4 Embedded WASM build compiled OpenCoreGraphics and JavaScriptKit, then failed in SwiftWebGPU/GPUErrors.swift because JSPromise.result is declared by JavaScriptEventLoop but that source imported only JavaScriptKit.",
      "epistemicStatus": "Verified",
      "confidence": 0.99,
      "source": "Local fixed-toolchain build log",
      "sourceUrl": "local://OpenCoreImage/swift-6.4-embedded-build",
      "reliability": 0.99,
      "supports": [
        "ea:session/2026-07-27_opencoreimage-embedded/topic/T002"
      ]
    },
    {
      "@id": "ea:session/2026-07-27_opencoreimage-embedded/evidence/E002",
      "@type": "Evidence",
      "title": "Embedded build next fails on OpenCoreGraphics Foundation import",
      "content": "After correcting JavaScriptEventLoop ownership imports, the fixed Embedded build advanced to OpenCoreGraphics and failed at CGAffineTransform.swift because Foundation is unavailable in Embedded mode. A separate compiler probe also rejected FoundationEssentials and rejected Foundation even with the normal WASI static module path injected.",
      "epistemicStatus": "Verified",
      "confidence": 0.99,
      "source": "Local fixed-toolchain build and compiler probes",
      "sourceUrl": "local://OpenCoreImage/swift-6.4-embedded-foundation-probes",
      "reliability": 0.99,
      "supports": [
        "ea:session/2026-07-27_opencoreimage-embedded/topic/T004"
      ]
    },
    {
      "@id": "ea:session/2026-07-27_opencoreimage-embedded/evidence/E003",
      "@type": "Evidence",
      "title": "Normal Swift 6.4 WASM target remains buildable",
      "content": "OpenCoreImage target build completed successfully with the fixed 2026-07-17 normal WASM SDK after explicit JavaScriptEventLoop imports.",
      "epistemicStatus": "Verified",
      "confidence": 0.99,
      "source": "Local fixed-toolchain build log",
      "sourceUrl": "local://OpenCoreImage/swift-6.4-wasm-build",
      "reliability": 0.99,
      "supports": [
        "ea:session/2026-07-27_opencoreimage-embedded/topic/T003"
      ]
    },
    {
      "@id": "ea:session/2026-07-27_opencoreimage-embedded/topic/T004",
      "@type": "Topic",
      "title": "Foundation-free graphics base is required for Embedded",
      "content": "OpenCoreImage cannot compile in Embedded mode until OpenCoreGraphics owns portable geometry and byte-storage contracts instead of relying on Foundation-provided CGFloat, CGPoint, CGRect, Data, and related APIs.",
      "epistemicStatus": "Verified",
      "confidence": 0.97,
      "decompositionStrategy": "transitive dependency and capability analysis",
      "derivedFrom": [
        "ea:session/2026-07-27_opencoreimage-embedded/evidence/E002"
      ]
    },
    {
      "@id": "ea:session/2026-07-27_opencoreimage-embedded/topic/T003",
      "@type": "Topic",
      "title": "Verified cross-target OpenCoreImage build",
      "content": "OpenCoreImage compiles and links on Native, WASM, and Embedded WASM, with behavior tests covering supported and unsupported renderer paths.",
      "epistemicStatus": "Hypothesized",
      "confidence": 0.3,
      "visualEvidenceRequirement": {
        "evidencePattern": "comparison",
        "requiredChartType": "target verification matrix"
      }
    },
    {
      "@id": "ea:session/2026-07-27_opencoreimage-embedded/insight/I001",
      "@type": "Insight",
      "title": "Capability-based renderer selection enables the target matrix",
      "content": "A common CIContext ownership contract combined with capability-specific renderers is expected to allow all targets to compile while keeping unavailable rendering explicit.",
      "epistemicStatus": "Hypothesized",
      "confidence": 0.45,
      "derivedFrom": [
        "ea:session/2026-07-27_opencoreimage-embedded/topic/T001",
        "ea:session/2026-07-27_opencoreimage-embedded/topic/T002"
      ],
      "rationale": "Architecture alone does not distinguish browser WASM from Embedded WASM; renderer capability must be selected at the construction boundary.",
      "supportsClaim": [
        "ea:session/2026-07-27_opencoreimage-embedded/topic/T003"
      ],
      "primaryEvidence": [],
      "counterEvidence": [],
